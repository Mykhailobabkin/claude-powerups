#!/bin/sh
# Generated by repo-standard.
root=$(git rev-parse --show-toplevel) || exit 1
previous=$(git config --path --get repoStandard.previousHooksPath || :)
if [ -n "$previous" ] && [ -x "$previous/pre-commit" ]; then
  "$previous/pre-commit" "$@" || exit $?
fi
python3 "$root/.repo-standard/check.py" "$root" --staged
